{
  "name": "devforge",
  "version": "0.1.0",
  "description": "A zero-dependency code editor and interactive curriculum for learning HTML, CSS, and JavaScript.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint js tests",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"*.md\"",
    "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\" \"*.md\""
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "vitest": "^2.0.5"
  }
}
