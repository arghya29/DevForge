{
  "name": "devforge",
  "version": "0.1.0",
  "description": "A zero-dependency code editor and interactive curriculum for learning HTML, CSS, and JavaScript.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint js tests",
    "format": "prettier --write \"**/*.{js,css,html,md,yml,json}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,md,yml,json}\"",
    "build": "echo 'No build required for static assets'"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9.9.0",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "vitest": "^2.0.5",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/user-event": "^14.6.6",
    "@testing-library/jest-dom": "^6.0.0"
  }
}
