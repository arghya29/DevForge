# DevForge Development Container Environment Variables

# Copy this file to .devcontainer/devcontainer.env and fill in your values
#
# Usage:
#   cp .devcontainer/devcontainer.env.example .devcontainer/devcontainer.env

# GitHub token for extended API access (optional)
# GITHUB_TOKEN=

# Node environment
NODE_ENV=development

# Disable npm update notifier in CI
NO_UPDATE_NOTIFIER=1